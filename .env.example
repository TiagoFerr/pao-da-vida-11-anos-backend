# ==========================================
# PAO DA VIDA - 120 CULTOS NOS LARES (API)
# Environment Variables Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/pao_da_vida_cultos?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=pao_da_vida_cultos
POSTGRES_PORT=5432

# Redis 7 (Cache, Session & SSE Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET="substitua-por-um-secret-seguro-com-minimo-64-caracteres-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="substitua-por-outro-secret-seguro-para-o-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"

# MinIO S3 Object Storage (Fotos dos Cultos)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="cultos-fotos"
MINIO_FORCE_PATH_STYLE=true
MINIO_PUBLIC_URL="http://localhost:9000/cultos-fotos"
